          {
            "in": "query",
            "name": "tenant_id",
            "required": true,
            "schema": {
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
              "title": "Tenant Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "finding",
            "required": false,
            "schema": {
              "anyOf": [
