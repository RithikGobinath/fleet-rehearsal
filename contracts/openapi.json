            "type": "string"
          },
          "advisory_revision": {
            "const": "1.1",
            "default": "1.1",
            "title": "Advisory Revision",
            "type": "string"
          },
          "advisory_url": {
            "default": "https://www.cisco.com/c/en/us/support/docs/csa/cisco-sa-cat9k-PtmD7bgy.html",
            "title": "Advisory Url",
            "type": "string"
          },
          "finding": {
            "enum": [
              "affected",
              "unaffected",
              "needs_evidence"
            ],
            "title": "Finding",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "observed_at": {
            "format": "date-time",
            "title": "Observed At",
            "type": "string"
          },
          "product": {
            "title": "Product",
            "type": "string"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "running_release": {
            "title": "Running Release",
            "type": "string"
          },
          "site_id": {
            "title": "Site Id",
            "type": "string"
          },
          "site_name": {
            "title": "Site Name",
            "type": "string"
          },
          "tenant_id": {
            "title": "Tenant Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "tenant_id",
          "site_id",
          "site_name",
          "product",
          "running_release",
          "finding",
          "reason",
          "observed_at"
        ],
        "title": "Asset",
        "type": "object"
      },
      "FingerprintRequest": {
        "additionalProperties": false,
        "properties": {
          "expected_fingerprint": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Expected Fingerprint",
            "type": "string"
          }
        },
        "required": [
          "expected_fingerprint"
        ],
        "title": "FingerprintRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "InventoryPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Asset"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "next_cursor",
          "total"
        ],
        "title": "InventoryPage",
        "type": "object"
      },
      "PreviewRequest": {
        "additionalProperties": false,
        "properties": {
          "base_revision": {
            "maximum": 9007199254740991.0,
            "minimum": 0.0,
            "title": "Base Revision",
            "type": "integer"
          }
        },
        "required": [
          "base_revision"
        ],
        "title": "PreviewRequest",
        "type": "object"
      },
      "Principal": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "tenants": {
            "items": {
              "$ref": "#/components/schemas/Tenant"
            },
            "title": "Tenants",
            "type": "array"
          }
        },
        "required": [
          "id",
          "label",
          "tenants"
        ],
        "title": "Principal",
        "type": "object"
      },
      "PrincipalList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Principal"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "PrincipalList",
        "type": "object"
      },
      "RehearsalContext": {
        "properties": {
          "clock_at": {
            "title": "Clock At",
            "type": "string"
          },
          "last_observed_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Observed At"
          },
          "pending": {
            "title": "Pending",
            "type": "boolean"
          },
          "role": {
            "enum": [
              "viewer",
              "partner_proposer",
              "customer_approver",
              "operator"
            ],
            "title": "Role",
            "type": "string"
          },
          "stale": {
            "title": "Stale",
            "type": "boolean"
          }
        },
        "required": [
          "role",
          "clock_at",
          "last_observed_at",
          "stale",
          "pending"
        ],
        "title": "RehearsalContext",
        "type": "object"
      },
      "SessionRequest": {
        "properties": {
          "principal_id": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
            "title": "Principal Id",
            "type": "string"
          }
        },
        "required": [
          "principal_id"
        ],
        "title": "SessionRequest",
        "type": "object"
      },
      "SessionResponse": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "token_type": {
            "const": "bearer",
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token"
        ],
        "title": "SessionResponse",
        "type": "object"
      },
      "Tenant": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          }
        },
        "required": [
          "id",
          "label"
        ],
        "title": "Tenant",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
