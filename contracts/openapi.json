    "/v1/tenants/{tenant_id}/sites/{site_id}/inventory/import": {
      "post": {
        "operationId": "importInventory",
        "parameters": [
          {
            "in": "path",
            "name": "tenant_id",
            "required": true,
            "schema": {
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
              "title": "Tenant Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "site_id",
            "required": true,
            "schema": {
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
              "title": "Site Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "rows": {
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
                          "title": "Id",
                          "type": "string"
                        },
                        "macsec": {
                          "anyOf": [
                            {
                              "type": "boolean"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "title": "Macsec"
                        },
                        "name": {
                          "maxLength": 120,
                          "minLength": 1,
                          "pattern": "^[^\\x00-\\x1f]+$",
                          "title": "Name",
                          "type": "string"
                        },
                        "observed_at": {
                          "format": "date-time",
                          "title": "Observed At",
                          "type": "string"
                        },
                        "product": {
                          "const": "Catalyst 9300",
                          "title": "Product",
                          "type": "string"
                        },
                        "release_status": {
                          "enum": [
                            "affected",
                            "unaffected",
                            "unknown"
                          ],
                          "title": "Release Status",
                          "type": "string"
                        },
                        "running_release": {
                          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
                          "title": "Running Release",
                          "type": "string"
                        },
                        "source_revision": {
                          "maximum": 9007199254740991,
                          "minimum": 1,
                          "title": "Source Revision",
                          "type": "integer"
                        },
                        "trunk_port": {
                          "anyOf": [
                            {
                              "type": "boolean"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "title": "Trunk Port"
                        },
                        "trustsec": {
                          "anyOf": [
                            {
                              "type": "boolean"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "title": "Trustsec"
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "product",
                        "running_release",
                        "release_status",
                        "observed_at",
                        "source_revision"
                      ],
                      "title": "InventoryRow",
                      "type": "object"
                    },
                    "maxItems": 250,
                    "minItems": 1,
                    "title": "Rows",
                    "type": "array"
                  }
                },
                "required": [
                  "rows"
                ],
                "title": "InventoryBatch",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "integer"
                  },
                  "title": "Response Importinventory",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Invalid session"
          },
          "403": {
            "description": "Operator role required"
          },
          "404": {
            "description": "Site not found in granted scope"
          },
          "409": {
            "description": "Batch rejected without changes; row conflicts"
          },
          "413": {
            "description": "Batch too large"
          },
          "415": {
            "description": "JSON required"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Import Inventory"
      }
    },
