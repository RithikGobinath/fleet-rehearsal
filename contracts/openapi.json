{
  "components": {
    "schemas": {
      "Asset": {
        "properties": {
          "advisory_id": {
            "const": "CVE-2025-20311",
            "default": "CVE-2025-20311",
            "title": "Advisory Id",
            "type": "string"
          },
          "advisory_revision": {
            "const": "1.1",
            "default": "1.1",
            "title": "Advisory Revision",
            "type": "string"
          },
          "advisory_url": {
            "default": "https://www.cisco.com/c/en/us/support/docs/csa/cisco-sa-cat9k-PtmD7bgy.html",
            "title": "Advisory Url",
            "type": "string"
          },
          "finding": {
            "enum": [
              "affected",
              "unaffected",
              "needs_evidence"
            ],
            "title": "Finding",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "observed_at": {
            "format": "date-time",
            "title": "Observed At",
            "type": "string"
          },
          "product": {
            "title": "Product",
            "type": "string"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "running_release": {
            "title": "Running Release",
            "type": "string"
          },
          "site_id": {
            "title": "Site Id",
            "type": "string"
          },
          "site_name": {
            "title": "Site Name",
            "type": "string"
          },
          "tenant_id": {
            "title": "Tenant Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "tenant_id",
          "site_id",
          "site_name",
          "product",
          "running_release",
          "finding",
          "reason",
          "observed_at"
        ],
        "title": "Asset",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "InventoryPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Asset"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "next_cursor",
          "total"
        ],
        "title": "InventoryPage",
        "type": "object"
      },
      "Principal": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "tenants": {
            "items": {
              "$ref": "#/components/schemas/Tenant"
            },
            "title": "Tenants",
            "type": "array"
          }
        },
        "required": [
          "id",
          "label",
          "tenants"
        ],
        "title": "Principal",
        "type": "object"
      },
      "PrincipalList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Principal"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "PrincipalList",
        "type": "object"
      },
      "SessionRequest": {
        "properties": {
          "principal_id": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
            "title": "Principal Id",
            "type": "string"
          }
        },
        "required": [
          "principal_id"
        ],
        "title": "SessionRequest",
        "type": "object"
      },
      "SessionResponse": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "token_type": {
            "const": "bearer",
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token"
        ],
        "title": "SessionResponse",
        "type": "object"
      },
      "Tenant": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          }
        },
        "required": [
          "id",
          "label"
        ],
        "title": "Tenant",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Fleet Rehearsal",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "health_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Healthz Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/v1/assets": {
      "get": {
        "operationId": "inventory_v1_assets_get",
        "parameters": [
          {
            "in": "query",
            "name": "tenant_id",
            "required": true,
            "schema": {
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
              "title": "Tenant Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "finding",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "affected",
                    "unaffected",
                    "needs_evidence"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Finding"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 25,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "After"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InventoryPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Invalid demo session"
          },
          "403": {
            "description": "Tenant forbidden"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Inventory"
      }
    },
    "/v1/assets/{asset_id}": {
      "get": {
        "operationId": "evidence_v1_assets__asset_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "asset_id",
            "required": true,
            "schema": {
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
              "title": "Asset Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "tenant_id",
            "required": true,
            "schema": {
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
              "title": "Tenant Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Asset"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Invalid demo session"
          },
          "403": {
            "description": "Tenant forbidden"
          },
          "404": {
            "description": "Asset not found in granted scope"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Evidence"
      }
    },
    "/v1/demo/principals": {
      "get": {
        "operationId": "demo_principals_v1_demo_principals_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrincipalList"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Demo Principals"
      }
    },
    "/v1/demo/session": {
      "post": {
        "operationId": "new_session_v1_demo_session_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "New Session"
      }
    }
  }
}
