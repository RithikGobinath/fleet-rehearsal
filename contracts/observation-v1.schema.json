{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic observation event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "event_id", "tenant_id", "site_id", "asset_id",
    "source_id", "source_revision", "observed_at", "received_at", "evidence"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "format": "uuid"},
    "tenant_id": {"$ref": "#/$defs/id"},
    "site_id": {"$ref": "#/$defs/id"},
    "asset_id": {"$ref": "#/$defs/id"},
    "source_id": {"$ref": "#/$defs/id"},
    "source_revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "observed_at": {"$ref": "#/$defs/utc"},
    "received_at": {"$ref": "#/$defs/utc"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["healthy"],
      "properties": {"healthy": {"type": "boolean"}}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "utc": {"type": "string", "format": "date-time", "pattern": "Z$"}
  }
}
