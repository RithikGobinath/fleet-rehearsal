{
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "fleet-rehearsal": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.json",
            "outputPath": "dist/fleet-rehearsal",
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "fixtures": {
              "fileReplacements": [
                { "replace": "src/inventory-http.ts", "with": "src/inventory-http.fixture.ts" }
              ]
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "fixtures": { "buildTarget": "fleet-rehearsal:build:fixtures" }
          }
        }
      }
    }
  }
}
